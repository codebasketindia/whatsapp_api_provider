# =====================================================================
# CB WhatsApp Gateway - backend environment (copy to /etc/cbwa/cbwa.env)
# chmod 600 /etc/cbwa/cbwa.env ; owner root:cbwa
# Meta App ID/Secret, Embedded Signup config, Razorpay keys, GST, SMTP and
# all prices are NOT here - an admin enters them in Settings (stored encrypted).
# =====================================================================

SPRING_PROFILES_ACTIVE=prod
CBWA_SERVER_PORT=8080
CBWA_PUBLIC_BASE_URL=https://wa.example.com
CBWA_FRONTEND_URL=https://wa.example.com
CBWA_CORS_ALLOWED_ORIGINS=https://wa.example.com

# ---- Database ----
CBWA_DB_URL=jdbc:mysql://127.0.0.1:3306/cbwa?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=utf8
CBWA_DB_USERNAME=cbwa_app
CBWA_DB_PASSWORD=
CBWA_DB_POOL_MAX=20

# ---- Security (generate each with the command shown) ----
# openssl rand -base64 64 | tr -d '\n'
CBWA_JWT_SECRET=
CBWA_JWT_ACCESS_TTL_MINUTES=15
CBWA_JWT_REFRESH_TTL_DAYS=7
# openssl rand -base64 32   (BACK IT UP - losing it makes stored Meta tokens/keys unreadable)
CBWA_ENCRYPTION_KEY=
# openssl rand -base64 32
CBWA_API_SECRET_PEPPER=
# First super admin (used only when no super admin exists; must change password at first login)
CBWA_SEED_ADMIN_EMAIL=admin@example.com
CBWA_SEED_ADMIN_PASSWORD=
CBWA_SWAGGER_ENABLED=false

# ---- Storage & logs ----
CBWA_STORAGE_PATH=/var/lib/cbwa/storage
CBWA_MAX_UPLOAD_MB=16
CBWA_LOG_PATH=/var/log/cbwa
CBWA_LOG_LEVEL=INFO

# ---- Mail bootstrap (Settings > SMTP overrides these once saved) ----
CBWA_MAIL_HOST=
CBWA_MAIL_PORT=587
CBWA_MAIL_USERNAME=
CBWA_MAIL_PASSWORD=
CBWA_MAIL_FROM=no-reply@example.com

# ---- Workers ----
CBWA_QUEUE_WORKER_THREADS=8
CBWA_QUEUE_BATCH_SIZE=50
CBWA_JOBS_ENABLED=true

# ---- External endpoints (change only for testing) ----
CBWA_META_GRAPH_BASE_URL=https://graph.facebook.com
CBWA_RAZORPAY_BASE_URL=https://api.razorpay.com
