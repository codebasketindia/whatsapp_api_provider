[Unit]
Description=CB WhatsApp Gateway (Spring Boot)
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=cbwa
Group=cbwa
WorkingDirectory=/opt/cbwa
EnvironmentFile=/etc/cbwa/cbwa.env
ExecStart=/usr/bin/java -Xms512m -Xmx1536m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError \
  -Duser.timezone=UTC -Djava.security.egd=file:/dev/./urandom \
  -jar /opt/cbwa/cbwa.jar
SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStopSec=60
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/cbwa /var/log/cbwa /opt/cbwa

[Install]
WantedBy=multi-user.target
